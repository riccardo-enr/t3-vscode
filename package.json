{
  "name": "t3-vscode",
  "displayName": "Threads for T3 Code",
  "description": "Unofficial VS Code client for the T3 Code server: threads, live chat and an agent dashboard.",
  "version": "0.1.1",
  "publisher": "riccardo-enr",
  "license": "MIT",
  "icon": "icon.png",
  "repository": { "type": "git", "url": "https://github.com/riccardo-enr/t3-vscode.git" },
  "bugs": { "url": "https://github.com/riccardo-enr/t3-vscode/issues" },
  "homepage": "https://github.com/riccardo-enr/t3-vscode#readme",
  "engines": { "vscode": "^1.101.0" },
  "main": "./extension.js",
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false, "description": "Runs git in the workspace and sends messages to the T3 server." }
  },
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "t3code.sendSelection", "title": "T3 Code: Send selection (draft)" },
      { "command": "t3code.sendToThread", "title": "T3 Code: Send selection to thread" },
      { "command": "t3code.newThread", "title": "T3 Code: New thread", "icon": "$(add)" },
      { "command": "t3code.connect", "title": "T3 Code: Connect to server" },
      { "command": "t3code.refresh", "title": "T3 Code: Refresh threads", "icon": "$(refresh)" },
      { "command": "t3code.openThread", "title": "T3 Code: Open in T3 Code app" },
      { "command": "t3code.openChat", "title": "T3 Code: Open chat" },
      { "command": "t3code.openUsage", "title": "T3 Code: Open usage dashboard" },
      { "command": "t3code.chatRefresh", "title": "T3 Code: Refresh chat", "icon": "$(refresh)" },
      { "command": "t3code.chatOpenInApp", "title": "T3 Code: Open chat thread in T3 Code app", "icon": "$(link-external)" },
      { "command": "t3code.showTurnChanges", "title": "T3 Code: Show changes of last turn", "icon": "$(diff)" },
      { "command": "t3code.openWorktree", "title": "T3 Code: Open worktree in Source Control", "icon": "$(source-control)" },
      { "command": "t3code.askFix", "title": "T3 Code: Ask T3 to fix" },
      { "command": "t3code.openDashboard", "title": "T3 Code: Open agent dashboard", "icon": "$(dashboard)" },
      { "command": "t3code.stopThread", "title": "T3 Code: Stop thread", "icon": "$(debug-stop)" },
      { "command": "t3code.settleThread", "title": "T3 Code: Settle thread", "icon": "$(check)" }
    ],
    "keybindings": [
      { "command": "t3code.sendSelection", "key": "ctrl+alt+shift+d", "mac": "cmd+alt+shift+d", "when": "editorHasSelection" },
      { "command": "t3code.sendToThread", "key": "ctrl+alt+shift+s", "mac": "cmd+alt+shift+s", "when": "editorHasSelection" },
      { "command": "t3code.chat.focus", "key": "ctrl+alt+shift+t", "mac": "cmd+alt+shift+t" }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "t3code", "title": "T3 Code", "icon": "icon.svg" }]
    },
    "views": {
      "t3code": [
        { "id": "t3code.threads", "name": "Threads" },
        { "id": "t3code.chat", "name": "Chat", "type": "webview" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "t3code.threads",
        "contents": "No open T3 Code threads for this workspace (settled and snoozed are hidden).\n[Refresh](command:t3code.refresh)"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "t3code.openThread", "when": "false" },
        { "command": "t3code.openChat", "when": "false" },
        { "command": "t3code.openWorktree", "when": "t3code.chatWorktree" },
        { "command": "t3code.askFix", "when": "false" },
        { "command": "t3code.stopThread", "when": "false" },
        { "command": "t3code.settleThread", "when": "false" }
      ],
      "view/title": [
        { "command": "t3code.newThread", "when": "view == t3code.threads", "group": "navigation@1" },
        { "command": "t3code.refresh", "when": "view == t3code.threads", "group": "navigation@2" },
        { "command": "t3code.openDashboard", "when": "view == t3code.threads", "group": "navigation@3" },
        { "command": "t3code.chatRefresh", "when": "view == t3code.chat", "group": "navigation@1" },
        { "command": "t3code.chatOpenInApp", "when": "view == t3code.chat", "group": "navigation@2" },
        { "command": "t3code.showTurnChanges", "when": "view == t3code.chat", "group": "navigation@3" },
        { "command": "t3code.openWorktree", "when": "view == t3code.chat && t3code.chatWorktree", "group": "navigation@4" },
        { "command": "t3code.stopThread", "when": "view == t3code.chat", "group": "navigation@5" },
        { "command": "t3code.settleThread", "when": "view == t3code.chat", "group": "navigation@6" }
      ],
      "view/item/context": [
        { "command": "t3code.openThread", "when": "view == t3code.threads && viewItem =~ /^thread/" },
        { "command": "t3code.sendToThread", "when": "view == t3code.threads && viewItem =~ /^thread/" },
        { "command": "t3code.showTurnChanges", "when": "view == t3code.threads && viewItem =~ /^thread/" },
        { "command": "t3code.stopThread", "when": "view == t3code.threads && viewItem == threadRunning", "group": "inline" },
        { "command": "t3code.settleThread", "when": "view == t3code.threads && viewItem =~ /^thread/" }
      ],
      "editor/context": [
        { "command": "t3code.sendSelection", "when": "editorHasSelection", "group": "t3code" },
        { "command": "t3code.sendToThread", "when": "editorHasSelection", "group": "t3code" }
      ]
    }
  }
}
